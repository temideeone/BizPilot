rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostic and Health Connection verification endpoint
    match /test/{testId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || (request.auth.token.email != null && request.auth.token.email == 'dayosamuel54@gmail.com'));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('full_name' in data) || data.full_name == null || (data.full_name is string && data.full_name.size() <= 500))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256))
        && (!('business_name' in data) || data.business_name == null || (data.business_name is string && data.business_name.size() <= 500))
        && (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() <= 800000))
        && (!('businessLogo' in data) || data.businessLogo == null || (data.businessLogo is string && data.businessLogo.size() <= 800000))
        && (!('created_at' in data) || data.created_at == null || (data.created_at is string && data.created_at.size() <= 60))
        && (!('userRole' in data) || data.userRole == null || (data.userRole is string && data.userRole.size() <= 200))
        && (!('industry' in data) || data.industry == null || (data.industry is string && data.industry.size() <= 200))
        && (!('orgSize' in data) || data.orgSize == null || (data.orgSize is string && data.orgSize.size() <= 200))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 500))
        && (!('routing' in data) || data.routing == null || (data.routing is string && data.routing.size() <= 100))
        && (!('account' in data) || data.account == null || (data.account is string && data.account.size() <= 100))
        && (!('bankName' in data) || data.bankName == null || (data.bankName is string && data.bankName.size() <= 200))
        && (!('currency' in data) || data.currency == null || (data.currency is string && data.currency.size() <= 50))
        && (!('timezone' in data) || data.timezone == null || (data.timezone is string && data.timezone.size() <= 100));
    }

    // User profile document permissions
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming());
      allow update: if isOwner(userId)
                    && isValidUser(incoming())
                    && (!('id' in existing()) || !('id' in incoming()) || incoming().id == existing().id);
      allow delete: if isOwner(userId);

      // Subcollection permissions for user-owned business documents & generated assets
      match /documents/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection permissions for user-owned advisory conversations
      match /conversations/{convoId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
